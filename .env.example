# Server
PORT=5000

# Redis (BullMQ & Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL (Docker Compose + Prisma 8)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=batch_converter
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/batch_converter?schema=public"

# S3 / SeaweedFS Object Storage
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secret
S3_BUCKET_NAME=batch-media
S3_REGION=us-east-1
