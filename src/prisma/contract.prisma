// use prisma-8

model Batch {
  id         String   @id
  status     String   @default("QUEUED")
  totalFiles Int
  createdAt  DateTime @default(now()) @onCreate(now())
  assets     Asset[]
}

model Asset {
  id           String   @id @onCreate(uuid())
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id])
  originalPath String
  outputPath   String
  fileSize     Int
  format       String
  createdAt    DateTime @default(now()) @onCreate(now())
}
